{
  "name": "auto-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:ff": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:ff": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:ff": "wxt zip -b firefox --mv3",
    "watch:ff": "nodemon --watch src -e js,ts,vue,css,html --exec \"npm run build:ff\"",
    "android": "web-ext run -t firefox-android -s .output/firefox-mv3 --firefox-apk org.mozilla.firefox_beta --adb-device",
    "clean": "rm -rf .output",
    "tsc": "vue-tsc --noEmit",
    "test": "tsx tests/validate-hostnames.ts && tsx tests/validate-wildcards.ts",
    "docs": "npm run docs:dev",
    "docs:build": "vitepress build docs",
    "docs:deploy": "npm run get-contributors && npm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "get-contributors": "npx get-contributors cssnr/auto-auth -f docs/.vitepress/contributors.json",
    "prettier": "npm run prettier:write",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "lint": "npx eslint src",
    "lint:web-ext": "npm run build:ff && npm run web-ext",
    "web-ext": "npx web-ext lint --source-dir .output/firefox-mv3",
    "package": "npm run tsc && npm run zip && npm run zip:ff",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@catppuccin/vitepress": "^0.1.4",
    "@cssnr/vitepress-plugin-contributors": "^0.2.0",
    "@cssnr/vitepress-swiper": "^0.3.1",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/chrome": "^0.2.7",
    "@types/firefox-webext-browser": "^143.0.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/i18n": "^0.2.7",
    "@wxt-dev/module-vue": "^1.0.3",
    "animate.css": "^4.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitepress": "next",
    "vitepress-chat": "^0.0.4",
    "vue-tsc": "^3.3.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
